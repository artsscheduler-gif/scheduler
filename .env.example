# Server only (Vercel environment variables). Never prefix these with VITE_.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
APP_URL=https://book.artsservicecenter.com
TOKEN_SECRET=            # 32+ random bytes, hex. Rotating it invalidates outstanding manage links.
CRON_SECRET=             # Vercel sends this as a Bearer token to cron routes.
BACKUP_ENCRYPTION_KEY=   # 32 bytes, hex. Keep a copy offline: backups are useless without it.
TURNSTILE_SECRET_KEY=
EMAIL_PROVIDER=resend    # resend | stub | capture (staging: saves to the Outbox, sends nothing)
RESEND_API_KEY=
EMAIL_DELIVER_TO=         # staging + capture only: comma list that also gets a real [TEST] copy (needs RESEND_API_KEY)
EMAIL_DELIVER_FROM=       # optional; default is Resend's test sender, which only reaches the Resend account's own email
MAIL_PROVIDER=lob        # lob | stub
LOB_API_KEY=             # test_... keys never print or mail anything
APP_ENV=                 # staging only: enables Outbox/Simulator actions. Leave empty in production.

# Client (safe to expose; the anon key has no table access).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_TURNSTILE_SITE_KEY=
VITE_SHOP_PHONE=          # Fallback shown if the database is unreachable. Keep in sync with Settings.
VITE_APP_ENV=             # staging only: TEST SITE bar, noindex, Outbox/Simulator tabs. Leave empty in production.
