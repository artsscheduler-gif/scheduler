{
  "name": "arts-service-center",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json && vite build && node scripts/check-bundle-secrets.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:db": "vitest run tests/db",
    "lab": "vitest run --config vitest.lab.config.ts",
    "stress": "tsx scripts/stress.ts",
    "db:start": "supabase start",
    "db:reset": "supabase db reset",
    "import:epicor": "tsx scripts/import-epicor.ts",
    "admin:add": "tsx scripts/add-admin.ts",
    "backup:restore": "tsx scripts/restore-backup.ts",
    "prelaunch": "tsx scripts/prelaunch-check.ts",
    "dev:api": "tsx watch scripts/dev-api.ts",
    "staging:api": "APP_ENV=staging EMAIL_PROVIDER=capture tsx watch scripts/dev-api.ts",
    "staging:web": "VITE_APP_ENV=staging vite",
    "smoke:staging": "tsx scripts/smoke-staging.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "fast-check": "^4.10.2",
    "otpauth": "^9.5.2",
    "playwright": "^1.64.1",
    "postgres": "^4.0.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  }
}
